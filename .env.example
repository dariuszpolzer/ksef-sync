# ================================
# KSeF API
# ================================

KSEF_BASE_URL=https://api.ksef.mf.gov.pl/v2
KSEF_NIP=12345678910
KSEF_TOKEN=Twój_token


# ================================
# Klucze kryptograficzne
# ================================

KSEF_PUBLIC_KEY_PATH=./keys/ksef_public_key.pem
KSEF_SYMMETRIC_KEY_CERT_PATH=./keys/ksef_symmetric_key.pem


# ================================
# Katalogi danych
# ================================

TAX_RUNTIME_DIR=C:\Users\USER\Documents\tax-runtime
KSEF_DATA_DIR=C:\Users\USER\Documents\tax-runtime\ksef-sync\prod
KSEF_AUTH_DIR=C:\Users\USER\Documents\tax-runtime\ksef-sync\prod\auth
KSEF_BATCH_DIR=C:\Users\USER\Documents\tax-runtime\ksef-sync\prod\batches
KSEF_EXPORT_DIR=C:\Users\USER\Documents\tax-runtime\ksef-sync\prod\exports
KSEF_DOWNLOAD_DIR=C:\Users\USER\Documents\tax-runtime\ksef-sync\prod\downloads
KSEF_LOG_DIR=C:\Users\USER\Documents\tax-runtime\ksef-sync\prod\logs


# ================================
# Timeouty i polling
# ================================

KSEF_HTTP_TIMEOUT=60
KSEF_AUTH_POLL_INTERVAL=2
KSEF_EXPORT_POLL_INTERVAL=20


# ================================
# Generowanie PDF
# ================================

GENERATE_PDF=false
KSEF_PDF_GENERATOR_DIR=./pdf_generator/ksef-pdf-generator
KSEF_PDF_TIMEOUT_SECONDS=120
